# Reglages de production, lus par docker-compose.yml.
#
# `./demarrer.sh` ecrit ce fichier tout seul au premier lancement, avec l'UID
# et le fuseau de la machine. Le copier a la main marche aussi :
#
#     cp .env.exemple .env
#
# Rien n'est obligatoire : sans .env, les valeurs ci-dessous s'appliquent deja.

# Identite des processus. Doit etre le proprietaire de backend/donnees/ :
# rien ne traduit les UID a travers un montage lie. `id -u` et `id -g`.
FRIGO_UID=1000
FRIGO_GID=1000

# L'heure que le terminal affiche : il n'a pas d'horloge fiable et recopie
# `aujourdhui=` et `heure=` du serveur.
TZ=Europe/Paris

# 0.0.0.0 pour que le terminal joigne le serveur depuis le Wi-Fi.
FRIGO_IP=0.0.0.0
FRIGO_PORT_SERVEUR=8080
FRIGO_PORT_VITRINE=8081

# 1 pour ne jamais interroger Open Food Facts.
FRIGO_HORS_LIGNE=0

# 0 silencieux, 1 les requetes, 2 tout.
FRIGO_VERBEUX=1

# Fils du site public : un par onglet connecte, WebSocket comprise.
FRIGO_FILS=32

# Mouvements envoyes au navigateur a la connexion.
FRIGO_JOURNAL=120

# Etiquette de l'image construite.
FRIGO_TAG=1.0.0
